{
  "name": "markrust-devtools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dev/test tooling ONLY. MarkRust runtime needs no Node, no bundler, no framework.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "test:browser": "node scripts/validate-browser.mjs",
    "test:native": "node scripts/validate-native.mjs",
    "test:native:multi": "node scripts/validate-native-multi.mjs"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
